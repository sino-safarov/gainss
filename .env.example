# Copy to .env and fill in from Supabase: Project Settings -> API.
# Both values are public by design; access is limited by row level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# "on" shows sign-in by e-mail code (needs custom SMTP and {{ .Token }} in the e-mail template).
VITE_EMAIL_LOGIN=off
